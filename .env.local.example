# Template only — no real values here.
#
# DO NOT create a .env.local in this folder. This project lives inside a
# OneDrive-synced directory, so any secret written here is uploaded to
# OneDrive and kept in its version history.
#
# Set these as Windows *user* environment variables instead. Next.js reads
# them from process.env exactly the same way:
#
#   powershell -ExecutionPolicy Bypass -File scripts\set-secrets.ps1
#
# That script prompts for each value and stores it with `setx`, outside the
# synced folder. Open a new terminal afterwards so the values are inherited.

# Anthropic API key for /api/claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Postgres connection string for better-auth + the devices/sessions tables.
# AWS RDS format:
#   postgresql://USER:PASSWORD@HOST.rds.amazonaws.com:5432/DBNAME?sslmode=require
DATABASE_URL=

# Optional: only needed if better-auth cannot infer its own base URL.
# BETTER_AUTH_URL=http://localhost:3000
